diff --git a/src/routes/orders-routes.ts b/src/routes/orders-routes.ts
index ce49842..81a5b34 100644
--- a/src/routes/orders-routes.ts
+++ b/src/routes/orders-routes.ts
@@ -90,6 +90,31 @@ export function ordersRoutes(app: FastifyInstance, dependencies: OrdersRouteDepe
     async (request, reply) =>
       relay(reply, await dependencies.orders.place(operatorOf(request), request.body)),
   );
+
+  app.post<{ Params: { orderId: string }; Body: { reason: string } }>(
+    '/api/orders/:orderId/cancellation',
+    {
+      preHandler: [signedIn, requireScope('orders:write')],
+      schema: {
+        params: { type: 'object', required: ['orderId'], properties: { orderId: uuid } },
+        body: {
+          type: 'object',
+          required: ['reason'],
+          additionalProperties: false,
+          properties: { reason: { type: 'string', minLength: 1, maxLength: 200 } },
+        },
+      },
+    },
+    async (request, reply) =>
+      relay(
+        reply,
+        await dependencies.orders.cancel(
+          operatorOf(request),
+          request.params.orderId,
+          request.body.reason,
+        ),
+      ),
+  );
 }
 
 export function operatorOf(request: { operator?: { id: string } }): string {
diff --git a/src/upstream/orders-api.ts b/src/upstream/orders-api.ts
index b326f29..d909f2d 100644
--- a/src/upstream/orders-api.ts
+++ b/src/upstream/orders-api.ts
@@ -10,6 +10,7 @@ export interface OrdersApi {
   list(operatorId: string, query: OrderListQuery): Promise<UpstreamResponse>;
   get(operatorId: string, orderId: string): Promise<UpstreamResponse>;
   place(operatorId: string, order: unknown): Promise<UpstreamResponse>;
+  cancel(operatorId: string, orderId: string, reason: string): Promise<UpstreamResponse>;
 }
 
 export function createOrdersApi(client: UpstreamClient): OrdersApi {
@@ -31,5 +32,13 @@ export function createOrdersApi(client: UpstreamClient): OrdersApi {
     place(operatorId, order) {
       return client.send({ method: 'POST', path: '/orders', operatorId, body: order });
     },
+    cancel(operatorId, orderId, reason) {
+      return client.send({
+        method: 'POST',
+        path: `/orders/${encodeURIComponent(orderId)}/cancellation`,
+        operatorId,
+        body: { reason },
+      });
+    },
   };
 }
