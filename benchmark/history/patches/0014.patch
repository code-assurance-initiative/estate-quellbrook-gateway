From: Teodor Vasko <teodor.vasko@example.invalid>
Date: Fri, 14 Aug 2026 11:20:05 +0200
Subject: feat: drivers and vehicles available, for the board's route planner

---
 src/routes/dispatch-routes.ts             | 24 +++++++++++++++++++++++
 tests/integration/dispatch-routes.test.ts | 15 ++++++++++++++
 2 files changed, 39 insertions(+)

diff --git a/src/routes/dispatch-routes.ts b/src/routes/dispatch-routes.ts
index 494df58..49289aa 100644
--- a/src/routes/dispatch-routes.ts
+++ b/src/routes/dispatch-routes.ts
@@ -69,4 +69,28 @@ export function dispatchRoutes(
         await dependencies.dispatch.startRoute(operatorOf(request), request.params.routeId),
       ),
   );
+
+  app.get<{ Querystring: { date: string; depot: string } }>(
+    '/api/dispatch/drivers/available',
+    {
+      schema: {
+        querystring: {
+          type: 'object',
+          required: ['date', 'depot'],
+          properties: { date, depot: { type: 'string', pattern: '^[A-Z]{3}$' } },
+        },
+      },
+    },
+    async (request, reply) => {
+      const operatorId = request.operator?.id ?? 'anonymous';
+      return relay(
+        reply,
+        await dependencies.dispatch.availableDrivers(
+          operatorId,
+          request.query.date,
+          request.query.depot,
+        ),
+      );
+    },
+  );
 }
diff --git a/tests/integration/dispatch-routes.test.ts b/tests/integration/dispatch-routes.test.ts
