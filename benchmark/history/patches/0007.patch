+apiVersion: v1
+kind: Namespace
+metadata:
+  name: quellbrook-edge
+  annotations:
+    # Every pod gets the mesh sidecar: in-cluster traffic is mutual TLS (docs/architecture.md).
+    linkerd.io/inject: enabled
+  labels:
+    app.kubernetes.io/part-of: quellbrook
+    quellbrook.example/team: edge
+    pod-security.kubernetes.io/enforce: restricted
+    pod-security.kubernetes.io/enforce-version: latest
diff --git a/deploy/k8s/networkpolicy.yaml b/deploy/k8s/networkpolicy.yaml
new file mode 100644
index 0000000..693345f
--- /dev/null
+++ b/deploy/k8s/networkpolicy.yaml
@@ -0,0 +1,83 @@
+# Default deny in both directions, then one allowance per real flow.
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: default-deny
+  namespace: quellbrook-edge
+spec:
+  podSelector: {}
+  policyTypes: ['Ingress', 'Egress']
+---
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: allow-dns
+  namespace: quellbrook-edge
+spec:
+  podSelector: {}
+  policyTypes: ['Egress']
+  egress:
+    - to:
+        - namespaceSelector:
+            matchLabels:
+              kubernetes.io/metadata.name: kube-system
+          podSelector:
+            matchLabels:
+              k8s-app: kube-dns
+      ports:
+        - protocol: UDP
+          port: 53
+        - protocol: TCP
+          port: 53
+---
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: gateway-from-ingress
+  namespace: quellbrook-edge
+spec:
+  podSelector:
+    matchLabels:
+      app.kubernetes.io/name: quellbrook-gateway
+  policyTypes: ['Ingress']
+  ingress:
+    - from:
+        - namespaceSelector:
+            matchLabels:
+              kubernetes.io/metadata.name: ingress-nginx
+      ports:
+        - protocol: TCP
+          port: 8080
+---
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: gateway-egress
+  namespace: quellbrook-edge
+spec:
+  podSelector:
+    matchLabels:
+      app.kubernetes.io/name: quellbrook-gateway
+  policyTypes: ['Egress']
+  egress:
+    - to:
+        - namespaceSelector:
+            matchLabels:
+              kubernetes.io/metadata.name: quellbrook-orders
+      ports:
+        - protocol: TCP
+          port: 8080
+    - to:
+        - namespaceSelector:
+            matchLabels:
+              kubernetes.io/metadata.name: quellbrook-dispatch
+      ports:
+        - protocol: TCP
+          port: 8080
+    - to:
+        - namespaceSelector:
+            matchLabels:
+              kubernetes.io/metadata.name: identity
+      ports:
+        - protocol: TCP
+          port: 443
