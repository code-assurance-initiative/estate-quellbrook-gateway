# Local development. Copy to .env and fill in; .env is ignored by git.
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=debug
OIDC_ISSUER=https://id.quellbrook.example/realms/operations
OIDC_AUDIENCE=quellbrook-console
OIDC_JWKS_URL=https://id.quellbrook.example/realms/operations/protocol/openid-connect/certs
TOKEN_URL=https://id.quellbrook.example/realms/operations/protocol/openid-connect/token
GATEWAY_CLIENT_ID=quellbrook-gateway-dev
# Ask the Edge team for a development client; never commit it.
GATEWAY_CLIENT_SECRET=
ORDERS_API_URL=http://localhost:5101
DISPATCH_API_URL=http://localhost:5102
UPSTREAM_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:5173
